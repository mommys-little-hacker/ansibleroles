---
extends: default

rules:
  line-length:
    max: 120
  comments:
    min-spaces-from-content: 1
  truthy:
    check-keys: false
  indentation:
    indent-sequences: consistent
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  .cache/
  .git/
  .molecule/
  .ansible/
  .ansibleroles/
